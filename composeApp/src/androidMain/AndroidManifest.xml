    <application android:allowBackup="false" android:label="Mawjic" android:icon="@drawable/mawjic_icon" android:theme="@style/AppTheme" android:usesCleartextTraffic="true">
        <activity android:name="app.mawjic.tv.android.MainActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden|uiMode" android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
